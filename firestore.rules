rules_version = '2';

// NyxOS Firestore rules.
// - Only signed-in users can read or write anything (except checking whether
//   a username is free, which happens before sign-up).
// - Users can only post as themselves; their name must match their account.
// - Messages: 1–500 characters, at most one per 2 seconds, none while banned.
// - Only the author or an admin can remove a message; only admins can ban.
// Admins are the UIDs listed in config/admins { uids: [...] } (set it in the
// Firebase console; clients can't write it).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9_]{3,20}$'); }
    // The account's sign-in email is <lowercase username>@nyx.local.
    function isMyName(n) { return validName(n) && request.auth.token.email == n.lower() + '@nyx.local'; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/config/admins)
        && get(/databases/$(database)/documents/config/admins).data.uids is list
        && me() in get(/databases/$(database)/documents/config/admins).data.uids;
    }
    function isBanned() { return exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }

    match /config/admins {
      allow read: if signedIn();
      allow write: if false;
    }

    // Username reservations. Doc id = lowercase username.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.auth.token.email == name + '@nyx.local'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == me()
        && validName(request.resource.data.name)
        && request.resource.data.name.lower() == name
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Public profile.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && isMyName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Private per-user data (block list). Only the owner can see it.
    match /private/{userId} {
      allow read: if signedIn() && userId == me();
      allow create, update: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['blocked'])
        && request.resource.data.blocked is map
        && request.resource.data.blocked.size() <= 1000;
      allow delete: if signedIn() && userId == me();
    }

    // Rate limit stamp, written in the same batch as each message.
    match /rate/{userId} {
      allow read: if signedIn() && userId == me();
      allow create: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time;
      allow update: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && request.time > resource.data.last + duration.value(2, 's');
      allow delete: if false;
    }

    match /messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && !isBanned()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == me()
        && isMyName(request.resource.data.name)
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        // The rate stamp must be written in this same batch (so it passed the 2 s check).
        && getAfter(/databases/$(database)/documents/rate/$(request.auth.uid)).data.last == request.time;
      // "Delete" = blank the text and mark it deleted (author or admin).
      allow update: if signedIn()
        && (resource.data.uid == me() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'deletedBy'])
        && request.resource.data.text == ''
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == me();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['msgId', 'msgUid', 'msgName', 'text', 'reason', 'reporter', 'reporterName', 'createdAt'])
        && request.resource.data.reporter == me()
        && isMyName(request.resource.data.reporterName)
        && request.resource.data.msgId is string && request.resource.data.msgId.size() <= 64
        && request.resource.data.msgUid is string && request.resource.data.msgUid.size() <= 128
        && request.resource.data.msgName is string && request.resource.data.msgName.size() <= 20
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.reason in ['spam', 'harassment', 'hate', 'personal', 'nsfw', 'other']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /bans/{userId} {
      allow get: if signedIn() && (userId == me() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'by', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }
  }
}
